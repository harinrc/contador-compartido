rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function isMember() { return signedIn() && (request.auth.uid in resource.data.memberIds); }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
    }

    match /counters/{counterId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isOwner() || isMember();
      allow update: if isOwner() || (
        isMember() &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.memberIds == resource.data.memberIds
      );
      allow delete: if isOwner();

      match /events/{eventId} {
        allow read, create: if signedIn() &&
          ((request.auth.uid in get(/databases/$(database)/documents/counters/$(counterId)).data.memberIds) ||
           request.auth.uid == get(/databases/$(database)/documents/counters/$(counterId)).data.ownerId);
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read, create, update: if signedIn() &&
          (request.auth.uid in get(/databases/$(database)/documents/counters/$(counterId)).data.memberIds);
        allow delete: if false;
      }

      match /typing/{userId} {
        allow read, write: if signedIn() &&
          (request.auth.uid in get(/databases/$(database)/documents/counters/$(counterId)).data.memberIds);
      }
    }
  }
}
