rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function isMember() { return signedIn() && (request.auth.uid in resource.data.memberIds); }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
    }

    match /counters/{counterId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isOwner() || isMember();
      allow update: if isOwner() || isMember();
      allow delete: if isOwner();
    }
  }
}
